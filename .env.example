# Safe, reproducible local demo: no keys required.
USE_MOCK_LLM=true
DATA_MODE=demo
DEMO_SCENARIO=rain
# All simulated data and rules are visibly labeled.
DATABASE_URL=sqlite:///./runtime/kisansaathi.db
CACHE_PATH=runtime/tool_cache.sqlite3
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
WEATHER_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10
TOOL_RETRIES=1
WEATHER_TTL_SECONDS=3600
WEATHER_MAX_AGE_HOURS=6
MANDI_TTL_SECONDS=21600
MANDI_MAX_AGE_HOURS=48
DATA_GOV_BASE_URL=https://api.data.gov.in/resource
# Verify the resource ID and field/filter mappings in config/mandi.yaml first.
DATA_GOV_RESOURCE_ID=
DATA_GOV_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=15
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
